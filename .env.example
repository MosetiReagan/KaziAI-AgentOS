# Copy to .env and adjust. Never commit real secrets.

KZ_ENV=development
KZ_LOG_LEVEL=info

# Storage driver: "memory" (embedded, zero-dependency) or "postgres"
KZ_STORAGE_DRIVER=memory
DATABASE_URL=postgresql://agentos:agentos@localhost:5432/agentos

# Queue driver: "inline" (embedded worker loop) or "bullmq"
KZ_QUEUE_DRIVER=inline
REDIS_URL=redis://localhost:6379

# Execution environment: "local" (workspace-confined host process) or "docker"
KZ_ENVIRONMENT=local
KZ_DOCKER_IMAGE=node:20-bookworm-slim

# Workspace root for run sandboxes
KZ_WORKSPACE_ROOT=.kazi/workspaces

# API
KZ_API_HOST=127.0.0.1
KZ_API_PORT=4319
KZ_API_KEY=dev-local-api-key

# Model providers (all optional; provider independence is enforced)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434

