# Copy to .env and edit before `docker compose up -d`. Everything here has a
# working default for a laptop; nothing here is a real secret.

POSTGRES_USER=kazi
POSTGRES_PASSWORD=kazi
POSTGRES_DB=kazi

# Pin the bootstrap admin key instead of reading it out of the API logs.
# KZ_API_BOOTSTRAP_KEY=kz_live_boot.REPLACE_ME

# Host ports.
KZ_GATEWAY_PORT=8080
KZ_API_PORT=4000
KZ_WORKER_PORT=4100
KZ_POSTGRES_PORT=5432
KZ_REDIS_PORT=6379

KZ_WORKER_CONCURRENCY=2
KZ_ORGANIZATION=org_local
KZ_PROJECT=prj_default

# `local` confines commands to the container; `docker` gives each run a real
# container of its own and requires the Docker socket (see docs/deployment.md).
KZ_ENVIRONMENT=local
KZ_NETWORK_ENABLED=false

# Comma-separated browser origins allowed to call the gateway directly.
# KZ_GATEWAY_CORS_ORIGIN=https://agentos.example.com
