{
  "name": "@kazi-ai/agentos",
  "version": "0.1.0",
  "description": "KaziAI AgentOS SDK: declare an agent, run it durably, observe everything it did.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean"
  },
  "dependencies": {
    "@kazi-ai/agentos-agent": "workspace:*",
    "@kazi-ai/agentos-context": "workspace:*",
    "@kazi-ai/agentos-core": "workspace:*",
    "@kazi-ai/agentos-executor": "workspace:*",
    "@kazi-ai/agentos-mcp": "workspace:*",
    "@kazi-ai/agentos-memory": "workspace:*",
    "@kazi-ai/agentos-persistence": "workspace:*",
    "@kazi-ai/agentos-policies": "workspace:*",
    "@kazi-ai/agentos-providers": "workspace:*",
    "@kazi-ai/agentos-recovery": "workspace:*",
    "@kazi-ai/agentos-runtime": "workspace:*",
    "@kazi-ai/agentos-tools": "workspace:*",
    "@kazi-ai/agentos-tracing": "workspace:*"
  }
}
