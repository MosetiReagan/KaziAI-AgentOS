{
  "name": "@kazi-ai/agentos-persistence",
  "version": "0.1.0",
  "description": "Storage drivers for KaziAI AgentOS: embedded durable JSONL store and Postgres/Prisma.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:push": "prisma db push --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@kazi-ai/agentos-core": "workspace:*",
    "@prisma/client": "^6.19.3"
  },
  "devDependencies": {
    "prisma": "6.19.3"
  }
}
