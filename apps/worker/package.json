{
  "name": "@kazi-ai/agentos-worker",
  "version": "0.1.0",
  "description": "The KaziAI AgentOS worker: claim queued runs, execute them durably, and shut down cleanly.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "kazi-agentos-worker": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "start": "node dist/bin.js"
  },
  "dependencies": {
    "@kazi-ai/agentos": "workspace:*",
    "@kazi-ai/agentos-core": "workspace:*",
    "@kazi-ai/agentos-persistence": "workspace:*",
    "@kazi-ai/agentos-recovery": "workspace:*",
    "@kazi-ai/agentos-runtime": "workspace:*",
    "bullmq": "^5.61.0"
  }
}
