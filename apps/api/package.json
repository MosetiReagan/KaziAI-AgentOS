{
  "name": "@kazi-ai/agentos-api",
  "version": "0.1.0",
  "description": "The KaziAI AgentOS HTTP API: create, control, inspect and stream runs.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "kazi-agentos-api": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "start": "node dist/bin.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@kazi-ai/agentos": "workspace:*",
    "@kazi-ai/agentos-agent": "workspace:*",
    "@kazi-ai/agentos-core": "workspace:*",
    "@kazi-ai/agentos-evaluation": "workspace:*",
    "@kazi-ai/agentos-persistence": "workspace:*",
    "@kazi-ai/agentos-policies": "workspace:*",
    "@kazi-ai/agentos-runtime": "workspace:*",
    "@kazi-ai/agentos-tools": "workspace:*",
    "fastify": "^5.6.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  }
}
